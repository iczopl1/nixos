--- a/src/animation/tag.c
+++ b/src/animation/tag.c
@@ -7,6 +7,23 @@
 #include "mango/manage/monitor.h"
 #include "mango/manage/tab.h"
 
+/* Short slide (tag_animation_slide_ratio < 1): move by a fraction of the
+ * monitor instead of fully off screen, like Hyprland's slidefade N%. */
+static bool tag_short_slide(Client *c, int32_t dir, int32_t *x, int32_t *y) {
+	if (config.tag_animation_slide_ratio >= 1.0f)
+		return false;
+	if (config.tag_animation_direction == VERTICAL) {
+		*x = c->animation.current.x;
+		*y = c->geom.y +
+			 dir * (int32_t)(c->mon->m.height * config.tag_animation_slide_ratio);
+	} else {
+		*x = c->geom.x +
+			 dir * (int32_t)(c->mon->m.width * config.tag_animation_slide_ratio);
+		*y = c->animation.current.y;
+	}
+	return true;
+}
