{
  "manifest_version": 2,
  "name": "Bar subtitles",
  "version": "1.1",
  "description": "Sends the YouTube caption line on screen to the desktop bar (localhost only).",
  "browser_specific_settings": {
    "gecko": {
      "id": "bar-subs@local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "http://127.0.0.1:47613/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "incognito": "spanning"
}
