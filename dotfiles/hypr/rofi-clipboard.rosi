* {
    bg:              #332E40F2;
    panel:           #564C6A80;
    panel-strong:    #C78AD0F2;
    border:          #A181C1;
    border-soft:     #815EAC;
    text:            #ECEFF4;
    text-dim:        #D8DEE9;
    text-faint:      #9483A8;
    accent:          #C088D0;
    active:          #453B52;
    urgent:          #8F5BB0;
    shadow:          #00000000;
    font:            "JetBrainsMono Nerd Font 12";

    background-color: transparent;
    text-color:       @text;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    anchor:           center;
    location:         center;
    y-offset:         22px;
    width:            860px;
    border:           2px;
    border-color:     @border-soft;
    border-radius:    26px;
    background-color: @bg;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    padding:          18px;
    spacing:          14px;
}

inputbar {
    background-color: @panel;
    border:           2px;
    border-color:     @border;
    border-radius:    18px;
    children:         [ prompt, entry ];
    padding:          12px 16px;
    spacing:          12px;
}

prompt {
    enabled:          true;
    background-color: @accent;
    text-color:       #1f1726;
    border-radius:    999px;
    padding:          5px 10px;
    str:              "CLIP";
}

entry {
    background-color: transparent;
    text-color:       @text;
    placeholder:      "Search clipboard history";
    placeholder-color:@text-faint;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            9;
    cycle:            false;
    dynamic:          true;
    fixed-height:     false;
    scrollbar:        false;
    spacing:          10px;
}

element {
    background-color: @panel;
    border:           0px;
    border-color:     transparent;
    border-radius:    20px;
    children:         [ element-icon, element-text ];
    padding:          10px 14px;
    spacing:          14px;
}

element normal.normal {
    background-color: @panel;
    text-color:       @text;
}

element selected.normal {
    background-color: @panel-strong;
    border-color:     @accent;
    text-color:       #1f1726;
}

element selected.active {
    background-color: @active;
    border-color:     @border;
    text-color:       @text;
}

element selected.urgent {
    background-color: @urgent;
    border-color:     @accent;
    text-color:       @text;
}

element-icon {
    background-color: transparent;
    size:             64px;
    border-radius:    14px;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

textbox-prompt-colon {
    enabled: false;
}

error-message {
    background-color: @urgent;
    text-color:       @text;
    border-radius:    16px;
    padding:          12px;
}
