* {
    bg:              #2E3440F2;
    panel:           #4C566A80;
    panel-strong:    #A5C4AEF2;
    border:          #8FA89A;
    border-soft:     #738E7E;
    text:            #ECEFF4;
    text-dim:        #D8DEE9;
    text-faint:      #8DA193;
    accent:          #9AB9A5;
    active:          #465248;
    urgent:          #8F5BB0;
    font:            "Noto Color Emoji 18, Noto Emoji 18, JetBrainsMono Nerd Font 18";

    background-color: transparent;
    text-color:       @text;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    anchor:           center;
    location:         center;
    y-offset:         22px;
    width:            760px;
    border:           2px;
    border-color:     @border-soft;
    border-radius:    26px;
    background-color: @bg;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    padding:          18px;
    spacing:          14px;
}

inputbar {
    background-color: @panel;
    border:           2px;
    border-color:     @border;
    border-radius:    18px;
    children:         [ prompt, entry ];
    padding:          12px 16px;
    spacing:          12px;
}

prompt {
    enabled:          true;
    background-color: @accent;
    text-color:       #17261d;
    border-radius:    999px;
    padding:          5px 10px;
    str:              "EMOJI";
}

entry {
    background-color: transparent;
    text-color:       @text;
    placeholder:      "Search emoji";
    placeholder-color:@text-faint;
}

listview {
    background-color: transparent;
    columns:          10;
    lines:            6;
    cycle:            false;
    dynamic:          true;
    fixed-columns:    true;
    fixed-height:     false;
    layout:           vertical;
    scrollbar:        false;
    spacing:          10px;
}

element {
    background-color: @panel;
    border:           0px;
    border-color:     transparent;
    border-radius:    20px;
    children:         [ element-text ];
    padding:          8px;
    spacing:          0px;
}

element normal.normal {
    background-color: @panel;
    text-color:       @text;
}

element selected.normal {
    background-color: @panel-strong;
    border-color:     @accent;
    text-color:       #17261d;
}

element selected.active {
    background-color: @active;
    border-color:     @border;
    text-color:       @text;
}

element selected.urgent {
    background-color: @urgent;
    border-color:     @accent;
    text-color:       #17261d;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    font:             "Noto Color Emoji 22, Noto Emoji 22, JetBrainsMono Nerd Font 22";
    horizontal-align: 0.5;
    vertical-align:   0.5;
}

textbox-prompt-colon {
    enabled: false;
}

error-message {
    background-color: @urgent;
    text-color:       #17261d;
    border-radius:    16px;
    padding:          12px;
}
