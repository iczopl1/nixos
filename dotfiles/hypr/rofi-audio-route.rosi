* {
    bg:              #2A2619F2;
    panel:           #5A503580;
    panel-strong:    #D8C983F2;
    border:          #CDBE78;
    border-soft:     #8F8049;
    text:            #F5F0DC;
    text-dim:        #DDD5B0;
    text-faint:      #9A9272;
    accent:          #D99252;
    active:          #443C26;
    urgent:          #C57F40;
    font:            "JetBrains Mono 12, Font Awesome 7 Free Solid 12, Noto Sans Symbols 12";

    background-color: transparent;
    text-color:       @text;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    anchor:           center;
    location:         center;
    width:            840px;
    border:           2px;
    border-color:     @border-soft;
    border-radius:    26px;
    background-color: @bg;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    padding:          18px;
    spacing:          14px;
}

inputbar {
    background-color: @panel;
    border:           2px;
    border-color:     @border;
    border-radius:    18px;
    children:         [ prompt, entry ];
    padding:          12px 16px;
    spacing:          12px;
}

prompt {
    enabled:          true;
    background-color: @accent;
    text-color:       #2A2312;
    border-radius:    999px;
    padding:          5px 10px;
    str:              "AUDIO";
}

entry {
    background-color: transparent;
    text-color:       @text;
    placeholder:      "Route app audio";
    placeholder-color:@text-faint;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            10;
    cycle:            false;
    dynamic:          true;
    fixed-height:     false;
    scrollbar:        false;
    spacing:          10px;
}

element {
    background-color: @panel;
    border:           0px;
    border-color:     transparent;
    border-radius:    20px;
    children:         [ element-text ];
    padding:          12px 14px;
    spacing:          14px;
}

element normal.normal {
    background-color: @panel;
    text-color:       @text;
}

element selected.normal {
    background-color: @panel-strong;
    border-color:     @accent;
    text-color:       #2A2312;
}

element selected.active {
    background-color: @active;
    border-color:     @border;
    text-color:       @text;
}

element selected.urgent {
    background-color: @urgent;
    border-color:     @accent;
    text-color:       #2A2312;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    font:             "JetBrains Mono 12, Font Awesome 7 Free 12, Font Awesome 7 Free Solid 12, Noto Sans Symbols 12";
    vertical-align:   0.5;
}

textbox-prompt-colon {
    enabled: false;
}

error-message {
    background-color: @urgent;
    text-color:       #2A2312;
    border-radius:    16px;
    padding:          12px;
}
