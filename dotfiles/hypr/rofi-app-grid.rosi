* {
    bg:              #313B34F2;
    panel:           #55645A80;
    panel-strong:    #A5C4AEF2;
    border:          #8FA89A;
    border-soft:     #738E7E;
    text:            #ECEFF4;
    text-dim:        #D8DEE9;
    text-faint:      #8DA193;
    accent:          #9AB9A5;
    active:          #465248;
    font:            "JetBrainsMono Nerd Font 12";

    background-color: transparent;
    text-color:       @text;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    anchor:           center;
    location:         center;
    width:            920px;
    border:           2px;
    border-color:     @border-soft;
    border-radius:    26px;
    background-color: @bg;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    padding:          18px;
    spacing:          14px;
}

inputbar {
    background-color: @panel;
    border:           2px;
    border-color:     @border;
    border-radius:    18px;
    children:         [ prompt, entry ];
    padding:          12px 16px;
    spacing:          12px;
}

prompt {
    enabled:          true;
    background-color: @accent;
    text-color:       #17261d;
    border-radius:    999px;
    padding:          5px 10px;
    str:              "APPS";
}

entry {
    background-color: transparent;
    text-color:       @text;
    placeholder:      "Search applications";
    placeholder-color:@text-faint;
}

listview {
    background-color: transparent;
    columns:          2;
    lines:            6;
    cycle:            false;
    dynamic:          false;
    fixed-columns:    true;
    fixed-height:     true;
    layout:           vertical;
    scrollbar:        false;
    spacing:          12px;
}

element {
    background-color: @panel;
    border:           0px;
    border-color:     transparent;
    border-radius:    20px;
    children:         [ element-icon, element-text ];
    orientation:      horizontal;
    padding:          14px 16px;
    spacing:          14px;
}

element normal.normal {
    background-color: @panel;
    text-color:       @text;
}

element selected.normal {
    background-color: @panel-strong;
    border-color:     @accent;
    text-color:       #17261d;
}

element selected.active {
    background-color: @active;
    border-color:     @border;
    text-color:       @text;
}

element-icon {
    background-color: transparent;
    size:             2.4em;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

textbox-prompt-colon {
    enabled: false;
}
