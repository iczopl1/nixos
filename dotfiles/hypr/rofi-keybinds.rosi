* {
    bg:              #3B3133F2;
    panel:           #64555A80;
    panel-strong:    #C4A5ABF2;
    border:          #A88F94;
    border-soft:     #8E7378;
    text:            #ECEFF4;
    text-dim:        #D8DEE9;
    text-faint:      #A18D91;
    accent:          #B99AA0;
    active:          #52464A;
    font:            "JetBrains Mono 11, Font Awesome 7 Free Solid 11, Noto Sans Symbols 11";

    background-color: transparent;
    text-color:       @text;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    anchor:           center;
    location:         center;
    width:            90%;
    height:           92%;
    border:           2px;
    border-color:     @border-soft;
    border-radius:    26px;
    background-color: @bg;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    padding:          18px;
    spacing:          14px;
}

inputbar {
    background-color: @panel;
    border:           2px;
    border-color:     @border;
    border-radius:    18px;
    children:         [ prompt, entry ];
    padding:          12px 16px;
    spacing:          12px;
}

prompt {
    enabled:          true;
    background-color: @accent;
    text-color:       #26171A;
    border-radius:    999px;
    padding:          5px 10px;
    str:              "KEYS";
}

entry {
    background-color: transparent;
    text-color:       @text;
    placeholder:      "Search keybinds";
    placeholder-color:@text-faint;
}

listview {
    background-color: transparent;
    columns:          4;
    lines:            16;
    cycle:            false;
    dynamic:          true;
    fixed-columns:    true;
    fixed-height:     false;
    layout:           vertical;
    scrollbar:        true;
    spacing:          10px;
}

element {
    background-color: @panel;
    border:           0px;
    border-color:     transparent;
    border-radius:    16px;
    children:         [ element-text ];
    orientation:      horizontal;
    padding:          10px 14px;
}

element normal.normal {
    background-color: @panel;
    text-color:       @text;
}

element selected.normal {
    background-color: @panel-strong;
    border-color:     @accent;
    text-color:       #26171A;
}

element selected.active {
    background-color: @active;
    border-color:     @border;
    text-color:       @text;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

textbox-prompt-colon {
    enabled: false;
}
